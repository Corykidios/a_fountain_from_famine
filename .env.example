# ============================================================
# A Fountain from Famine — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# Never commit the real .env.

# --- Master Key (required) ---
# A key YOU invent — clients use this to authenticate to the proxy.
# Generate something random, e.g.: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-choose-your-own-long-random-secret-here

# --- NVIDIA NIM (optional but recommended) ---
# Comma-separated lists of NIM API keys from build.nvidia.com.
# Get keys from two NVIDIA accounts (free tier). Each list can have
# multiple keys for the multi-key pool.
NIM_API_KEY_CCC=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NIM_API_KEY_EOS=nvapi-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# --- DeepSeek (optional) ---
# Comma-separated bearer tokens from browser local storage.
# DevTools -> Application -> Local Storage -> https://chat.deepseek.com -> userToken
DEEPSEEK_TOKENS=
# Or single email/password login (used only if no tokens):
# DEEPSEEK_EMAIL=
# DEEPSEEK_PASSWORD=

# --- Qwen (optional) ---
# Comma-separated bearer tokens from browser local storage.
# DevTools -> Application -> Local Storage -> https://chat.qwen.ai -> token
QWEN_TOKENS=
# Or single email/password login (used only if no tokens):
# QWEN_EMAIL=
# QWEN_PASSWORD=

# --- Server config ---
DANYAPI_HOST=0.0.0.0
DANYAPI_PORT=8000
DANYAPI_TIMEOUT=60
DANYAPI_ACQUIRE_TIMEOUT=
DANYAPI_SESSION_CACHE_SIZE=128
DANYAPI_SESSION_TTL_SECONDS=3600
DANYAPI_CACHE_DIR=
DANYAPI_CACHE_DISABLED=
DANYAPI_LOG_LEVEL=INFO
DANYAPI_LOG_FILE=
DANYAPI_LOG_MAX_BYTES=10485760
DANYAPI_LOG_BACKUP_COUNT=3
